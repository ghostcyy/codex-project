      "comparison",
      "process",
      "bullet-list",
      "chart",
      "stat-highlight"
    ],
    "closing": "cta"
  },
  "audienceFit": [
    "engineers",
    "policy-makers",
    "executives"
  ],
  "formatFit": [
    "briefing",
    "report",
    "analysis"
